      "parameters": {
        "jsCode": "const jobs = $input.all();\n\nconst report = jobs.map((item, index) => {\n  const job = item.json;\n\n  const title = job.title || 'Titolo non disponibile';\n  const company = job.company?.display_name || 'Azienda non specificata';\n  const location = job.location?.display_name || 'Località non specificata';\n  const created = job.created\n    ? new Date(job.created).toLocaleDateString('it-IT')\n    : 'Data non disponibile';\n  const url = job.redirect_url || 'Link non disponibile';\n\n  return `${index + 1}. ${title}\nAzienda: ${company}\nLocalità: ${location}\nPubblicato: ${created}\nLink: ${url}`;\n}).join('\\n\\n-----------------------------\\n\\n');\n\nreturn [\n  {\n    json: {\n      subject: `Job Scout - ${jobs.length} opportunità trovate`,\n      report: `PERSONAL JOB SCOUT\n\nHo trovato ${jobs.length} annunci compatibili con i tuoi criteri.\n\n${report}`\n    }\n  }\n];"
      },
